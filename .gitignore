# SAGO Standard .gitignore (Experiments)

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.ai.example
!.env.whatsapp.example
secrets/
*.pem
*.key
credentials.json

# Dependencies & Environments
.venv/
venv/
env/
node_modules/
__pycache__/
*.pyc
*.tsbuildinfo
*.log
.pytest_cache/
.npm/

# Local Data & SQLite Databases
*.db
*.sqlite
*.sqlite3

# Large Media & Client Exports
*.mp4
*.mkv
*.avi
*.mov
*.mp3
*.wav
*.m4a
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# OS & Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.codex/
.agents/

# Application build/runtime artifacts
dist/
build/
coverage/
/data/
/artifacts/

# Portable local Git history export
*.bundle

# Private local speech fixtures used for explicit evaluations.
/recordings/
