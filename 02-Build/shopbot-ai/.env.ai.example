# Private local-only Gemini credentials. Copy to .env.ai; never commit that file.
# Enable only after choosing an explicit cumulative test allowance.
ALLOW_PAID_INFERENCE=false
ALLOW_FREE_INFERENCE=false
GEMINI_API_KEY=
AI_BUDGET_USD=0
AI_MODEL=gemini-3.5-flash-lite
ALLOW_MULTIMODAL_INFERENCE=true
GEMINI_UNIFIED_UNDERSTANDING_ENABLED=true
GEMINI_HANDWRITTEN_LISTS_ENABLED=true
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
