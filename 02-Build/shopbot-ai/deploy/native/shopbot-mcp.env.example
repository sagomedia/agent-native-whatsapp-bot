# Store outside Git, chmod 600, and replace placeholders locally.
SHOPBOT_MCP_DATABASE_URL=postgres://SHOP_SPECIFIC_ROLE:SET_LOCALLY@127.0.0.1:5432/SHOP_DATABASE
SHOPBOT_MCP_STORE_ID=00000000-0000-4000-8000-000000000000
SHOPBOT_MCP_ACTOR=codex-merchant

# Explicit owner delegation only; also requires an appropriately authorized DB role.
# The dedicated inventory/draft role remains unable to write published products.
SHOPBOT_MCP_ALLOW_PUBLISH=false
