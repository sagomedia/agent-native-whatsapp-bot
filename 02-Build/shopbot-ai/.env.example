APP_MODE=mock
APP_PORT=3017
# Synthetic local database only. Set private credentials before any hosted use.
POSTGRES_PASSWORD=shopbot-local-only
DATABASE_URL=postgres://shopbot:shopbot-local-only@localhost:5437/shopbot
MEDIA_DIR=./data/media

# Native evaluation is an explicit CLI action; simulator stays mock-only.
ALLOW_LOCAL_AI_TEST=false
ALLOW_FREE_INFERENCE=false
WHATSAPP_AI_ENABLED=false
WHATSAPP_DEFAULT_LANGUAGE=ta
WHATSAPP_TYPING_ENABLED=false
ALLOW_MULTIMODAL_INFERENCE=false
WHATSAPP_MEDIA_ENABLED=false
WHATSAPP_DISCOVERY_STAGES_ENABLED=false
WHATSAPP_MEDIA_RECOMMENDATION_ENABLED=false
WHATSAPP_SEQUENTIAL_ITEMS_ENABLED=false
AI_QUOTA_PROJECT=invisible-erp
ALLOW_PAID_INFERENCE=false
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Optional dedicated voice recognition; requires existing paid multimodal authorization.
GEMINI_TRANSCRIPTION_MODEL=
# No spending ceiling is implied. Set a positive USD amount only for an authorized run.
AI_BUDGET_USD=0

# Owner planning assumption only; not a verified Meta category rate.
WHATSAPP_PLANNING_PAISE=50

# Optional owner preview. Set all five together after creating its Access app.
# Requires mock mode, loopback HOST, and ALLOW_LOCAL_AI_TEST=false.
OWNER_HOSTNAME=
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=
OWNER_EMAIL=
OWNER_STORE_ID=

# Optional Meta test connection. Secrets stay in the private VPS env, never Git.
# Separate hostname exposes only /webhooks/whatsapp. Max five verified recipients.
WHATSAPP_ENABLED=false
WHATSAPP_PROCESS_ENABLED=false
WHATSAPP_SEND_ENABLED=false
# Independent stage bounds. Defaults preserve one planner; quota/budget admission still applies.
WHATSAPP_PLANNING_WORKERS=1
WHATSAPP_MEDIA_WORKERS=1
WHATSAPP_OUTBOUND_WORKERS=1
WHATSAPP_HOSTNAME=
WHATSAPP_WEBHOOK_PATH=/webhooks/whatsapp
WHATSAPP_PRIVACY_PUBLISHED=false
WHATSAPP_STORE_ID=
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Test mode keeps the pilot allowlist; public mode accepts all customer numbers
# with durable burst/repetition handover and no extra AI classifier calls.
WHATSAPP_AUDIENCE=test
WHATSAPP_TEST_RECIPIENTS=

# Optional delivery accounting. Use the timezone and currency shown by the
# Messaging account; the business phone is digits, not WHATSAPP_PHONE_ID.
# WHATSAPP_ACCOUNT_TIMEZONE=Asia/Kolkata
# WHATSAPP_ACCOUNT_CURRENCY=INR
# WHATSAPP_BUSINESS_PHONE_NUMBER=<verified business phone digits>
# No Meta INR rate is assumed. Supply a reviewed JSON rate card as described in
# ../../03-Output/032-p2-cost-and-admission.md. Missing rates remain unknown.
# WHATSAPP_RATE_CARD_JSON=<reviewed JSON>
# Optional gross reply-planning estimate, in integer millionths of a rupee.
# Use either micro-INR or legacy whole paise, never both. Order prices stay paise.
# WHATSAPP_SERVICE_RATE_MICRO_INR=<verified nonnegative integer>

# Customer estimate / standalone UPI advance. Owner verifies actual bank receipt.
WHATSAPP_PARTIAL_REVIEWS_ENABLED=false
UPI_ADVANCE_ENABLED=false
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=
# SHA-256 filename of an approved, bundled Tamil welcome recording (without .ogg).
WHATSAPP_WELCOME_AUDIO_HASH=
SHOPBOT_REQUIRE_VERIFIED_RELEASE=false

# Temporary shared-password demo login; default keeps Cloudflare identity login.
# Generate a scrypt hash using node --import tsx scripts/demo-password.ts
# OWNER_LOGIN_MODE=cloudflare
# OWNER_DEMO_PASSWORD_HASH=scrypt-v1$<32 hex salt>$<128 hex derived key>
# OWNER_DEMO_SESSION_HOURS=24
