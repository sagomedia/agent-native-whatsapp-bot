# Add to the existing configuration; keep channel credentials and AI budget.
WHATSAPP_VISUAL_ORDERING_ENABLED=false
WHATSAPP_MAX_DRAFT_LINES=50
# Configured combined provider/channel charge, in paise, for a service reply.
# Meta service replies inside the 24-hour window have no Meta message charge.
WHATSAPP_SERVICE_RATE_PAISE=0
VISUAL_MEDIA_DIR=./data/visual-images
LOCAL_VISUAL_ORDERING_ENABLED=false

# Unified customer text / audio / image extraction (same Flash Lite model)
GEMINI_UNIFIED_UNDERSTANDING_ENABLED=true
GEMINI_HANDWRITTEN_LISTS_ENABLED=true
