{
  "name": "shopbot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --config apps/dashboard/vite.config.ts && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/apps/server/src/index.js",
    "dev": "tsx apps/server/src/index.ts",
    "test:integration": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "db:migrate": "tsx apps/server/src/db/maintenance.ts migrate",
    "db:reset:mock": "tsx apps/server/src/db/maintenance.ts reset",
    "native:eval": "tsx scripts/evaluate-native.ts",
    "native:preflight": "tsx scripts/evaluate-native.ts --preflight",
    "preview:customer": "node --import tsx scripts/customer-preview.ts",
    "catalog:stage": "tsx scripts/import-catalog-package.ts",
    "mcp:catalog": "tsx apps/server/src/mcp/stdio.ts",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "preview:owner": "tsx scripts/owner-rehearsal.ts",
    "pilot:evidence": "tsx scripts/pilot-evidence.ts",
    "release:restore-rehearsal": "tsx scripts/rehearse-restore.ts",
    "catalog:bulk": "tsx scripts/import-bulk-catalog.ts",
    "catalog:capacity": "tsx scripts/catalog-capacity.ts",
    "catalog:scale-eval": "tsx scripts/evaluate-catalog-scale.ts",
    "catalog:facts": "tsx scripts/import-shop-facts.ts",
    "demo:evidence": "tsx scripts/demo-evidence.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@google/genai": "2.26.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fontkit": "^2.0.4",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
